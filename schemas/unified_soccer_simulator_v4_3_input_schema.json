{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnifiedSoccerSimulatorV4_3Input",
  "type": "object",
  "required": [
    "competition",
    "home_team",
    "away_team",
    "home_score",
    "away_score",
    "minute",
    "markets"
  ],
  "properties": {
    "snapshot_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "competition": {
      "type": "string"
    },
    "home_team": {
      "type": "string"
    },
    "away_team": {
      "type": "string"
    },
    "home_score": {
      "type": "integer",
      "minimum": 0
    },
    "away_score": {
      "type": "integer",
      "minimum": 0
    },
    "minute": {
      "type": "number",
      "minimum": 0
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_stoppage_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "extra_time_possible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "market_includes_extra_time": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "match_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "stats": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "recent_window": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "previous_snapshots": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "red_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "injuries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "substitutions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recent_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "line"
        ],
        "properties": {
          "line": {
            "type": "number",
            "enum": [
              0.5,
              1.5,
              2.5,
              3.5,
              4.5,
              5.5,
              6.5,
              7.5,
              8.5
            ]
          },
          "over": {
            "type": [
              "integer",
              "null"
            ]
          },
          "under": {
            "type": [
              "integer",
              "null"
            ]
          },
          "timestamp": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    },
    "target_bet": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "OVER",
            "UNDER"
          ]
        },
        "line": {
          "type": "number",
          "enum": [
            0.5,
            1.5,
            2.5,
            3.5,
            4.5,
            5.5,
            6.5,
            7.5,
            8.5
          ]
        },
        "odds": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "position": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "OVER",
            "UNDER"
          ]
        },
        "line": {
          "type": "number",
          "enum": [
            0.5,
            1.5,
            2.5,
            3.5,
            4.5,
            5.5,
            6.5,
            7.5,
            8.5
          ]
        },
        "odds": {
          "type": "integer"
        },
        "stake": {
          "type": "number",
          "minimum": 0
        },
        "cash_out": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "hedge_odds": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "monte_carlo": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "requested_simulations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1000
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "calibration_note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}